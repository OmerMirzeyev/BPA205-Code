@using PronionAndAdmin_Task.Models
﻿
@model List<Product>




<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Products</h2>

        <a asp-controller="Product"
               asp-action="Create"
               class="btn btn-primary">
            Add Product
        </a>
    </div>

    <div class="table-responsive">

        <table class="table table-hover align-middle shadow-sm">

            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Price</th>
                    <th>SKU</th>
                    <th>Categories</th>
                    <th>Tags</th>
                    <th>Reviews</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (Product product in Model)
                {
                    <tr>

                        <td>@product.Id</td>

                        <td>
                            <img src="~/uploads/product/@product.ImageUrl"
                                 width="70"
                                 height="70"
                                 style="object-fit:cover;border-radius:10px;" />
                        </td>

                        <td class="fw-semibold">
                            @product.Name
                        </td>

                        <td>
                            $@product.Price
                        </td>

                        <td>
                            @product.SKU
                        </td>

                        <td>
                            @if (product.Categories.Count > 0)
                            {
                                foreach (Category category in product.Categories)
                                {
                                    <span class="badge bg-primary me-1">
                                        @category.Name
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-warning">
                                    Empty
                                </span>
                            }
                        </td>

                        <td>
                            @if (product.Tags.Count > 0)
                            {
                                foreach (Tag tag in product.Tags)
                                {
                                    <span class="badge bg-dark me-1">
                                        @tag.Name
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-warning">
                                    Empty
                                </span>
                            }
                        </td>

                        <td>
                            @if (product.Reviews.Count > 0)
                            {
                                <span class="badge bg-success">
                                    @product.Reviews.Count Reviews
                                </span>
                            }
                            else
                            {
                                <span class="text-warning">
                                    No Review
                                </span>
                            }
                        </td>
                        <td>
                            @if (!product.IsDeleted)
                            {
                                <span class="badge bg-success">
                                    Active
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-danger">
                                    Deleted
                                </span>
                            }
                        </td>
                        <td>
                            <div class="d-flex gap-2 justify-content-center">
                                <a asp-controller="Product" asp-action="Update" asp-route-id="@product.Id"
                                       class="btn btn-warning btn-sm">
                                    Update
                                </a>
                                @if (!product.IsDeleted)
                                {
                                    <form asp-controller="Product" asp-action="Delete" asp-route-id="@product.Id">

                                        <button type="submit"
                                                class="btn btn-danger btn-sm">
                                            Delete
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-controller="Product" asp-action="Restore" asp-route-id="@product.Id">
                                        <button type="submit"
                                                class="btn btn-success btn-sm">
                                            Restore
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>