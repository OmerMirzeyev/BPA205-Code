@using PronionAndAdmin_Task.Areas.Admin.ViewModels.Product
@using PronionAndAdmin_Task.Models

@model UpdateProductVM

<div>
    <h1 class="text-primary">Update Product</h1>
    <form asp-controller="Product" asp-action="Update" method="post" enctype="multipart/form-data">
        <div class="mb-3">
            <label for="Name" class="form-label">Name</label>
            <input asp-for="@Model.Name" type="text" class="form-control" id="Name" placeholder="Add Name...">
                <span class="text-danger" asp-validation-for="@Model.Name"></span>
            </div>
            <div class="mb-3">
                <label for="Price" class="form-label">Price</label>
                <input asp-for="@Model.Price" type="number" class="form-control" id="Price" placeholder="Add Price...">
                    <span class="text-danger" asp-validation-for="@Model.Price"></span>
                </div>
                <div class="mb-3">
                    <label for="Description" class="form-label">Description</label>
                    <input asp-for="@Model.Description" type="text" class="form-control" id="Description" placeholder="Add Description...">
                        <span class="text-danger" asp-validation-for="@Model.Description"></span>
                    </div>
                    <div class="mb-3">
                        <select asp-for="CategoryIds" class="form-select" multiple aria-label="Multiple select Categories">
                            <option disabled selected>Select Categories</option>
                            @foreach (Category category in ViewBag.Categories)
                            {
                                <option value="@category.Id">@category.Name</option>
                            }
                        </select>
                        <span class="text-danger" asp-validation-for="@Model.CategoryIds"></span>
                    </div>
                    <div class="mb-3">
                        <select asp-for="TagIds" class="form-select" multiple aria-label="Multiple select Tags">
                            <option disabled selected>Select Tags</option>
                            @foreach (Tag tag in ViewBag.Tags)
                            {
                                <option value="@tag.Id">@tag.Name</option>
                            }
                        </select>
                        <span class="text-danger" asp-validation-for="@Model.TagIds"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Submit</button>
                </form>
 
            </div>


