@model Product
<div>
    <h1 class="text-primary">Update product</h1>
    <form asp-controller="Product" asp-action="Update" method="post" enctype="multipart/form-data">

        <div class="form-group">
            <label for="title">Title</label>
            <input asp-for="@Model.Title" type="text" class="form-control" id="title" placeholder="Add title...">
            </div>
            <div class="form-group">
                <label for="price">Price</label>
                <input asp-for="@Model.Price" type="number" class="form-control" id="price" placeholder="Add price...">
                </div>
                <div class="form-group">
                    <label for="imgUrl">ImageURL</label>
                    <input asp-for="@Model.ImageFile" type="file" class="form-control" id="imgUrl" " placeholder="Add imageURL...">
                    </div>
                    <button type="submit" class="btn btn-primary">Submit</button>
                </form>
            </div>