@model Product
<div>
    <h1 class="text-primary">Add product</h1>
    <form asp-controller="Product" asp-action="Create" method="post" enctype="multipart/form-data">

    <div class="form-group">
        <label for="title">Title</label>
        <input asp-for="@Model.Title" type="text" class="form-control" id="title" placeholder="Add title...">
                <span class="text-danger" asp-validation-for="@Model.Title"></span>
    </div>
    <div class="form-group">
        <label for="price">Price</label>
        <input asp-for="@Model.Price" type="number" class="form-control" id="price"  placeholder="Add price...">
                    <span class="text-danger" asp-validation-for="@Model.Price"></span>
    </div>
    <div class="form-group">
        <label for="imgUrl">ImageURL</label>
        <input asp-for="@Model.ImageFile" type="file" class="form-control" id="imgUrl"  placeholder="Add imageURL...">
                        <span class="text-danger" asp-validation-for="@Model.ImageFile"></span>
    </div>
    <button type="submit" class="btn btn-primary">Submit</button>
</form>
</div>