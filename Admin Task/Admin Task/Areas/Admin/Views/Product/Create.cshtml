@model Product


<div>
    <h1 class="text-primary">Add product</h1>
    <form asp-controller="Product" asp-action="Create" method="post">

        <div class="form-group">
            <label for="title">Title</label>
            <input asp-for="@Model.Title" type="text" class="form-control" id="title" placeholder="Add title...">
            </div>
            <div class="form-group">
                <label for="category">Category</label>
                <input asp-for="@Model.Category" type="text" class="form-control" id="category" placeholder="Add category...">
                </div>
                <div class="form-group">
                    <label for="ImageUrl">ImageURL</label>
                    <input asp-for="@Model.ImageUrl" type="text" class="form-control" id="ImageUrl" placeholder="Add imageURL...">
                    </div>
                    <button type="submit" class="btn btn-primary">Submit</button>
                </form>
            </div>
